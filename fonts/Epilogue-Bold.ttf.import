[remap]

importer="font_data_dynamic"
type="FontFile"
uid="uid://epiloguebold"

[deps]

source_file="res://fonts/Epilogue-Bold.ttf"
dest_files=["res://.godot/imported/Epilogue-Bold.ttf-xxxxx.fontdata"]

[params]

Rendering=null
Antialiasing=1
Hinting=2
SubpixelPositioning=1
Oversampling=0.0
Fallbacks=[]
FallbackToSystem=false
ForceAutohinter=false
Bitmap=false
MultichannelSignedDistanceField=false
MSDFPixelRange=8
MSDFSize=48
UseMipmaps=false
Compress=true
preload={}
language_support={}
script_support=[]
opentype_features={}
preload_glyph_ranges=[ ]
