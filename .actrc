# act configuration for running GitHub Actions locally

# Container Architecture
--container-architecture linux/amd64

# Note: The following flags are deprecated and have been removed:
# - --volume: Not supported by act, use ${{ github.workspace }} in workflows
# - --shm-size: Not supported by this version of act
# - --container-ubuntu-full: Deprecated

# Note: Volume mounts in workflows now use ${{ github.workspace }} for compatibility
