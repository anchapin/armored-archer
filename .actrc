# Godot Environment Variables
--env GODOT_HEADLESS=true
--env DISPLAY=:99

# Container Architecture
--container-architecture linux/amd64

# Note: --volume, --shm-size, and --container-ubuntu-full flags are not supported in this act version
# These were commented out due to incompatibility:
# --volume /home/runner/.local/share/godot:/root/.local/share/godot
# --volume /home/runner/.config/godot:/root/.config/godot
# --shm-size=2gb
# --container-ubuntu-full
