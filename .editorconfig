root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Godot files
[*.gd]
indent_style = space
indent_size = 4

[*.tscn]
indent_style = space
indent_size = 2

[*.tres]
indent_style = space
indent_size = 2

# TypeScript/JavaScript
[*.{ts,js}]
indent_style = space
indent_size = 2

# JSON and YAML
[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
