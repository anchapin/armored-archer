[gd_resource type="StyleBoxFlat" format=3]

[resource]
// Card style - Highest surface level per Stitch spec
bg_color = Color(0.149, 0.149, 0.149, 1)  // #262626 surface_container_highest
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

// Ghost border - 15% opacity for "etched metal" look
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.282, 0.282, 0.282, 0.15)  // #484848 at 15%

// Ambient glow effect (no black shadows)
shadow_color = Color(0, 0, 0, 0)