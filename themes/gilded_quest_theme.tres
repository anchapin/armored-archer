colors/on_secondary_container = Color(0.867, 0.808, 0.749, 1) // #ddcebf

// Tertiary - Green (health, uncommon rarity)
colors/tertiary = Color(0.494, 0.973, 0.224, 1)            // #7ef839
colors/tertiary_dim = Color(0.384, 0.859, 0.075, 1)        // #62db13
colors/tertiary_fixed = Color(0.431, 0.918, 0.157, 1)      // #70ea28
