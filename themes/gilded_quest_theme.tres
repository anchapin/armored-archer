colors/surface_container_highest = Color(0.149, 0.149, 0.149, 1) // #262626
colors/surface_bright = Color(0.173, 0.173, 0.173, 1)       // #2c2c2c
colors/surface_variant = Color(0.149, 0.149, 0.149, 1)     // #262626
colors/surface_tint = Color(1, 0.675, 0.329, 1)            // #ffac54

// On-Surface colors
