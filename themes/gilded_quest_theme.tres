// Label settings - will use custom fonts when imported
Label/colors/font_color = Color(1, 1, 1, 1)  // White text for dark theme
Label/colors/font_color_shadow = Color(0, 0, 0, 0.3)
Label/label_settings = null
LabelSettings/display_large = ExtResource("1")
LabelSettings/headline = ExtResource("2")
LabelSettings/title = ExtResource("3")
LabelSettings/body = ExtResource("4")

// Button styles - Tactile Triggers with 4px corner radius
Button/styles/normal = ExtResource("5")
Button/styles/hover = ExtResource("6")
Button/styles/pressed = ExtResource("7")
Button/styles/disabled = null
Button/styles/focus = ExtResource("5")

// Panel styles
PanelContainer/styles/panel = ExtResource("8")
PanelContainer/styles/card = ExtResource("9")
PanelContainer/styles/modal = ExtResource("10")

// Default corner radius constants - 4px for "machined part" look
constants/default_corner_radius = 4
constants/default_corner_radius_small = 4
constants/default_corner_radius_large = 12

// XL corner radius for modals (atmospheric blur + glass)
constants/xl_corner_radius = 16