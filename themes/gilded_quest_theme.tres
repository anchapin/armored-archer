colors/on_primary_container = Color(0.290, 0.157, 0, 1)    // #4a2800
colors/on_primary_fixed = Color(0.153, 0.075, 0, 1)        // #271300
colors/on_primary_fixed_variant = Color(0.337, 0.188, 0, 1) // #563000

// Secondary - Weathered iron/cream
colors/secondary = Color(0.937, 0.878, 0.82, 1)            // #efe0d1
