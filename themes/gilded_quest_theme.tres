[resource]
default_font = null
default_font_size = 16

// Stitch Dark Theme - "THE RELIC ARCHIVE"
// Dark obsidian foundation with golden "Loot Glow" accent

// Surface Hierarchy (Background Shift Architecture)
colors/surface_dim = Color(0.054, 0.054, 0.055, 1)        // #0e0e0e Base layer
colors/surface = Color(0.054, 0.054, 0.055, 1)            // #0e0e0e
colors/surface_container_lowest = Color(0, 0, 0, 1)        // #000000
colors/surface_container_low = Color(0.074, 0.075, 0.076, 1) // #131313
colors/surface_container = Color(0.098, 0.102, 0.102, 1)     // #191a1a
