# Godot 4+ specific ignores
.godot/
/android/

# Python caches
__pycache__/
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Node.js
node_modules/
npm-debug.log*

# OS specific
.DS_Store
Thumbs.db

# Environment and secrets
.env
.env.local
.env.staging
.env.production
.env.alpha
.env.beta
.env.development
.env.*.local
backend/.env
backend/.env.*
!backend/.env.example
!backend/.env.*.example
backend/coverage
backend/tsconfig.tsbuildinfo

# Node cache
node-compile-cache/
v8-compile-cache-*/
jest_rs/

# Eforge
.eforge/

# Local binaries and downloads
.bin/

# CI-generated reports
*.jscpd-report.json
tech-debt-report.json
.bundle-size-history.json
agents-md-validation-report.json

# GUT JUnit output (regenerated on every test run; issue #996 pattern)
test/results/*.xml

# Compiled Nakama bundle at repo root (runtime mount target only; built by
# cold-start.sh / start.sh when missing — mirrors backend/data/modules, #996)
data/modules/

# Smoke test reports
reports/smoke-tests/

# Local CI optimization files (user-specific)
.actrc-local
.act-logs/
act-cache/

# Local docker-compose files for CI
.docker/docker-compose-ci-local.yml
backend/docker-compose.override.yml

# Editor/agent backup files
*.bak

# Agent session results (transient)
.agents/results/

# Agent/human work-handoff files (cross-repo or session-only; issue #1186).
# Keep in sync with scripts/pre-commit-check-handoff-files.sh DENY_PATTERN.
.continue-*
*.continue-here*
*-handoff.md
pause-work*
wip-*.md

.gitnexus

# Generated performance benchmark snapshots (issue #1073) - real
# measurements regenerated by scripts/run-headless-performance-benchmark.sh
backend/tests/fixtures/performance/generated/
