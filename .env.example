# ============================================
# Environment Template (.env.example)
# Copy this file to .env and fill in your values
# ============================================

# ============================================
# Nakama Server Configuration (Backend)
# ============================================
# URL of the Nakama game server
NAKAMA_SERVER_URL=127.0.0.1
# Port for Nakama server (default: 7350)
NAKAMA_SERVER_PORT=7350
# Server key for authentication (change in production!)
NAKAMA_SERVER_KEY=your_nakama_server_key_here

# ============================================
# Firebase Cloud Messaging Configuration
# ============================================
# Enable/disable Firebase push notifications
FIREBASE_ENABLED=false

# Firebase Project ID (from Firebase Console)
FIREBASE_PROJECT_ID=your-project-id

# Firebase Service Account Client Email
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Firebase Private Key (escape newlines with \n)
# Format: FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# Firebase Database URL (optional)
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# ============================================
# Alertmanager Configuration
# ============================================
# Slack webhook URL for critical alerts
SLACK_WEBHOOK_CRITICAL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Slack webhook URL for warning/info alerts
SLACK_WEBHOOK_WARNING=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# SMTP configuration for email notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@armored-archer.example.com
SMTP_PASS=your_smtp_password_here

# PagerDuty integration key (optional)
PAGERDUTY_SERVICE_KEY=your_pagerduty_service_key_here

# ============================================
# Monitoring & Observability
# ============================================
# Prometheus URL
PROMETHEUS_URL=http://localhost:9090

# Alertmanager URL
ALERTMANAGER_URL=http://localhost:9093

# Grafana URL
GRAFANA_URL=http://localhost:3000
