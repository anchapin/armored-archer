extends RefCounted

class_name CoverageExporter

# Coverage data exporter for writing coverage.json
# Implemented in: 13-01-PLAN.md Task 1

func export_coverage_json(coverage_data: Dictionary, output_path: String) -> int:
	"""Export coverage data to JSON file."""
	# Coverage outputs are untracked runtime artifacts (#1063) — the target
	# directory does not exist on fresh clones, so create it before writing.
	var dir_path := output_path.get_base_dir()
	if not DirAccess.dir_exists_absolute(dir_path):
		var dir_error := DirAccess.make_dir_recursive_absolute(dir_path)
		if dir_error != OK:
			return ERR_FILE_CANT_WRITE
	var file = FileAccess.open(output_path, FileAccess.WRITE)
	if file == null:
		return ERR_FILE_CANT_WRITE

	# Wrap coverage data with metadata
	var export_data = {
		"_comment": "Generated by GUT coverage plugin - contains line execution data",
		"coverage": coverage_data
	}
	
	var json_string = JSON.stringify(export_data, "\t")
	file.store_string(json_string)
	file.close()

	return OK
