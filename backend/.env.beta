# ============================================
# Beta Environment Configuration
# Generated: Beta Readiness Phase
# DO NOT COMMIT THIS FILE TO VERSION CONTROL
# ============================================

NODE_ENV=beta

# ============================================
# Nakama Server Configuration
# ============================================
NAKAMA_SERVER_URL=beta.armored-archer.internal
NAKAMA_SERVER_PORT=7350
NAKAMA_SERVER_KEY=beta_server_key_production_ready
NAKAMA_CONSOLE_PORT=7351
NAKAMA_CONSOLE_USERNAME=admin
NAKAMA_CONSOLE_PASSWORD=beta_admin_secure_password

# ============================================
# Database Configuration
# ============================================
POSTGRES_USER=postgres
POSTGRES_DB=nakama_beta
POSTGRES_PASSWORD=beta_db_password_change_me
DATABASE_ADDRESS=postgres://postgres:beta_db_password_change_me@postgres:5432/nakama_beta
DB_HOST=postgres
DB_PORT=5432
DB_NAME=nakama_beta
DB_USER=postgres
DB_PASSWORD=beta_db_secure_password_change_me

# ============================================
# Session Configuration
# ============================================
SESSION_ENCRYPTION_KEY=beta_session_encryption_key_change_me
REFRESH_ENCRYPTION_KEY=beta_refresh_encryption_key_change_me
TOKEN_ENCRYPTION_KEY=beta_token_encryption_key_change_me
SESSION_EXPIRY_SEC=7200

# ============================================
# RevenueCat Configuration (Production)
# ============================================
REVENUECAT_PUBLIC_API_KEY=your_revenuecat_production_public_key
REVENUECAT_SECRET_API_KEY=your_revenuecat_production_secret_key
REVENUECAT_PUBLIC_KEY=your_revenuecat_production_public_key

# ============================================
# Firebase Configuration (Production)
# ============================================
FIREBASE_API_KEY=your_firebase_production_api_key
FIREBASE_PROJECT_ID=armored-archer-beta
FIREBASE_AUTH_DOMAIN=armored-archer-beta.firebaseapp.com
FIREBASE_DATABASE_URL=https://armored-archer-beta.firebaseio.com
FIREBASE_STORAGE_BUCKET=armored-archer-beta.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id

# ============================================
# Rate Limiting Configuration
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_MAX_REQUESTS=500
RATE_LIMIT_DEFAULT_WINDOW_MS=60000

# ============================================
# Logger Configuration
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_OUTPUT=stdout

# ============================================
# Match Configuration
# ============================================
ALLOW_HOST_LOOPBACK=false

# ============================================
# Metrics Configuration
# ============================================
METRICS_NAMESPACE=nakama
METRICS_PREFIX=nakama
PROMETHEUS_PORT=9100

# ============================================
# Alerting Configuration
# ============================================
ALERTING_ENABLED=true
ALERTING_DEFAULT_PROVIDER=slack
ALERTING_MIN_ENV_LEVEL=beta
SLACK_WEBHOOK_URL=your_slack_webhook_url
SLACK_CHANNEL=#beta-alerts

# ============================================
# Beta-Specific Configuration
# ============================================
BETA_BUILD_ID=beta-001
BETA_VERSION=v2.1.0-beta.1
BETA_DEBUG_ENABLED=false
BETA_TEST_USERS_ENABLED=true
BETA_MAX_TEST_USERS=500
BETA_ONBOARDING_ENABLED=true
BETA_FEEDBACK_ENABLED=true

# ============================================
# Beta Environment Endpoints
# ============================================
BETA_API_URL=https://beta-api.armored-archer.internal
BETA_WS_URL=wss://beta-ws.armored-archer.internal
BETA_CONSOLE_URL=https://beta-console.armored-archer.internal

# ============================================
# Monitoring & Observability
# ============================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=armored-archer-beta
