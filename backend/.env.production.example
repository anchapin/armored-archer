NODE_ENV=production

# Nakama Configuration
NAKAMA_CONSOLE_PORT=7351
NAKAMA_CONSOLE_USERNAME=admin
NAKAMA_CONSOLE_PASSWORD=<change_me_strong_password>
NAKAMA_SOCKET_PORT=7350
NAKAMA_SOCKET_SERVER_KEY=<change_me_unique_key>
NAKAMA_SERVER_KEY=<change_me_unique_key>

# Database Configuration
DB_HOST=<database_host>
DB_PORT=5432
DB_NAME=nakama
DB_USER=<database_user>
DB_PASSWORD=<database_password>
DATABASE_ADDRESS=postgres://<database_user>:<database_password>@<database_host>:5432/nakama
NAKAMA_DATABASE_ADDRESS=postgres://<database_user>:<database_password>@<database_host>:5432/nakama
POSTGRES_PASSWORD=<database_password>

# RevenueCat Configuration
REVENUECAT_PUBLIC_KEY=<your_revenuecat_public_key>
# Secret key (used for server-side API calls - never expose to client)
REVENUECAT_SECRET_KEY=<your_revenuecat_secret_key>
# Webhook secret for verifying incoming webhook signatures from RevenueCat.
# REQUIRED: without it the webhook RPC fails closed and rejects all events (issue #1067)
REVENUECAT_WEBHOOK_SECRET=<your_revenuecat_webhook_secret>

# Session Configuration
SESSION_EXPIRY_SEC=7200
REFRESH_ENCRYPTION_KEY=<change_me_long_random_string_32_chars_min>
TOKEN_ENCRYPTION_KEY=<change_me_long_random_string_32_chars_min>
SESSION_ENCRYPTION_KEY=<change_me_long_random_string_32_chars_min>

# Logger Configuration
LOG_LEVEL=WARN
LOG_FORMAT=json
LOG_OUTPUT=stdout

# Match Configuration
ALLOW_HOST_LOOPBACK=false

# Metrics Configuration
METRICS_NAMESPACE=nakama
METRICS_PREFIX=nakama
PROMETHEUS_PORT=9100

# Alerting Configuration
ALERTING_ENABLED=true
ALERTING_DEFAULT_PROVIDER=slack
ALERTING_MIN_ENV_LEVEL=production
ALERTING_ROUTING_CRITICAL=pagerduty
ALERTING_ROUTING_ERROR=slack
ALERTING_ROUTING_WARNING=slack
ALERTING_ROUTING_INFO=none

# PagerDuty Configuration (for critical alerts)
PAGERDUTY_API_KEY=<your_pagerduty_api_key>
PAGERDUTY_SERVICE_ID=<your_pagerduty_service_id>
PAGERDUTY_INTEGRATION_KEY=<your_pagerduty_integration_key>

# Slack Configuration (for error and warning alerts)
SLACK_WEBHOOK_URL=<your_slack_webhook_url>
SLACK_CHANNEL=#production-alerts
SLACK_USERNAME=Armored Archer Alert Bot
SLACK_ICON_EMOJI=:warning:
