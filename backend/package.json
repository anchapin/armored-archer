{
  "name": "armored-archer-backend",
  "version": "0.1.0",
  "description": "Nakama backend server for Armored Archer game",
  "main": "build/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage",
    "test:integration": "jest -c backend/jest.integration.config.js",
    "test:flaky": "ts-node scripts/detect-flaky-tests.ts",
    "test:flaky:ci": "ts-node scripts/detect-flaky-tests.ts --ci-mode",
    "test:report": "ts-node scripts/flaky-test-report.ts",
    "lint": "eslint src/**/*.ts --quiet",
    "lint:fix": "eslint src/**/*.ts --fix --quiet",
    "lint:all": "eslint src/ --no-ignore --quiet",
    "complexity": "eslint src/**/*.ts --quiet --rule 'complexity: [error, { max: 15 }]' --rule 'import/order: off' --rule 'prettier/prettier: off' --rule 'import/no-duplicates: off' --rule 'import/no-cycle: off' --rule '@typescript-eslint/no-unused-vars: off' --rule '@typescript-eslint/no-require-imports: off' --rule 'import/no-unresolved: off'",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc --out docs src",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "bundle:analyze": "webpack --mode=production --config webpack.analyze.config.js --analyze",
    "bundle:analyze:dev": "webpack --mode=development --config webpack.analyze.config.js --analyze",
    "bundle:check": "node scripts/bundle-analysis.js",
    "depcheck": "depcheck",
    "dep:count": "node -e \"const p = require('./package.json'); console.log('Total:', Object.keys(p.dependencies).length + Object.keys(p.devDependencies).length); console.log('Prod:', Object.keys(p.dependencies).length); console.log('Dev:', Object.keys(p.devDependencies).length);\""
  },
  "keywords": [
    "nakama",
    "game-server",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.3",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "depcheck": "^1.4.7",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.7.1",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.0",
    "ts-node-dev": "^2.0.0",
    "typedoc": "^0.28.17",
    "typescript": "^5.2.0",
    "webpack": "^5.105.4",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@heroiclabs/nakama-js": "^2.5.1",
    "@opentelemetry/auto-instrumentations-node": "^0.52.0",
    "@opentelemetry/exporter-jaeger": "^1.28.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/exporter-zipkin": "^1.28.0",
    "@opentelemetry/resources": "1.27.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opentelemetry/semantic-conventions": "1.27.0",
    "@sentry/node": "^10.40.0",
    "js-yaml": "^4.1.1",
    "lru-cache": "^11.2.6",
    "prom-client": "^15.0.0",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "zod": "^4.3.6"
  }
}
