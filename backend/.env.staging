NODE_ENV=staging

# Nakama Configuration
NAKAMA_CONSOLE_PORT=7351
NAKAMA_CONSOLE_USERNAME=admin
NAKAMA_CONSOLE_PASSWORD=${NAKAMA_CONSOLE_PASSWORD}
NAKAMA_SOCKET_PORT=7350
NAKAMA_SOCKET_SERVER_KEY=${NAKAMA_SOCKET_SERVER_KEY}
NAKAMA_SERVER_KEY=${NAKAMA_SERVER_KEY}

# Database Configuration
DB_HOST=${DB_HOST}
DB_PORT=5432
DB_NAME=nakama
DB_USER=${DB_USER}
DB_PASSWORD=${DB_PASSWORD}
DATABASE_ADDRESS=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:5432/nakama
NAKAMA_DATABASE_ADDRESS=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:5432/nakama
POSTGRES_PASSWORD=${DB_PASSWORD}

# RevenueCat Configuration
REVENUECAT_PUBLIC_KEY=${REVENUECAT_PUBLIC_KEY}

# Session Configuration
SESSION_EXPIRY_SEC=7200
REFRESH_ENCRYPTION_KEY=${REFRESH_ENCRYPTION_KEY}
TOKEN_ENCRYPTION_KEY=${TOKEN_ENCRYPTION_KEY}
SESSION_ENCRYPTION_KEY=${SESSION_ENCRYPTION_KEY}

# Logger Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_OUTPUT=stdout

# Match Configuration
ALLOW_HOST_LOOPBACK=false

# Metrics Configuration
METRICS_NAMESPACE=nakama
METRICS_PREFIX=nakama
PROMETHEUS_PORT=9100

# Alerting Configuration
ALERTING_ENABLED=true
ALERTING_DEFAULT_PROVIDER=slack
ALERTING_MIN_ENV_LEVEL=staging
ALERTING_ROUTING_CRITICAL=pagerduty
ALERTING_ROUTING_ERROR=slack
ALERTING_ROUTING_WARNING=slack
ALERTING_ROUTING_INFO=none
