{{ define "slack.critical.title" }}
🚨 CRITICAL ALERT: {{ .GroupLabels.alertname }}
{{ end }}

{{ define "slack.critical.text" }}
*Alert:* {{ .GroupLabels.alertname }}
*Severity:* {{ .CommonLabels.severity }}
*Service:* {{ .CommonLabels.service }}
*Component:* {{ .CommonLabels.component }}
*Environment:* {{ .CommonLabels.environment }}

*Description:*
{{ .CommonAnnotations.description }}

*Impact:*
{{ .CommonAnnotations.impact }}

*Started:* {{ .StartsAt.Format "2006-01-02 15:04:05 UTC" }}
*Ended:* {{ if .EndsAt }}{{ .EndsAt.Format "2006-01-02 15:04:05 UTC" }}{{ else }}_not yet resolved_{{ end }}

{{ if .CommonAnnotations.runbook_url }}*Runbook:* {{ .CommonAnnotations.runbook_url }}{{ end }}
{{ if .CommonAnnotations.dashboard_url }}*Dashboard:* {{ .CommonAnnotations.dashboard_url }}{{ end }}

*Troubleshooting Steps:*
{{ .CommonAnnotations.troubleshooting }}
{{ end }}

{{ define "slack.critical.actions" }}
[
  {
    "type": "button",
    "text": "📊 View Dashboard",
    "url": "{{ .CommonAnnotations.dashboard_url }}"
  },
  {
    "type": "button",
    "text": "📋 View Runbook",
    "url": "{{ .CommonAnnotations.runbook_url }}"
  },
  {
    "type": "button",
    "text": "🔗 Acknowledge",
    "url": "https://your-pagerduty.com"
  }
]
{{ end }}

