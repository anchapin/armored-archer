{{ define "email.critical.subject" }}[CRITICAL] {{ .GroupLabels.alertname }} - Armored Archer{{ end }}

{{ define "email.critical.html" }}
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      line-height: 1.6;
      color: #333;
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
    }
    .alert-critical {
      background-color: #ffebee;
      border-left: 4px solid #f44336;
      padding: 20px;
      margin: 20px 0;
      border-radius: 4px;
    }
    .alert-header {
      display: flex;
      align-items: center;
      margin-bottom: 15px;
    }
    .alert-icon {
      font-size: 32px;
      margin-right: 10px;
    }
    .alert-title {
      font-size: 20px;
      font-weight: bold;
      color: #c62828;
    }
    .label {
      font-weight: bold;
      color: #555;
    }
    .value {
      color: #333;
    }
    .section {
      margin: 20px 0;
    }
    .section-title {
      font-size: 16px;
      font-weight: bold;
      color: #c62828;
      margin-bottom: 10px;
      border-bottom: 1px solid #ffcdd2;
      padding-bottom: 5px;
    }
    .button {
      display: inline-block;
      background-color: #f44336;
      color: white;
      padding: 12px 24px;
      text-decoration: none;
      border-radius: 4px;
      margin: 5px 10px 5px 0;
      font-weight: bold;
    }
    .button:hover {
      background-color: #d32f2f;
    }
    .troubleshooting {
      background-color: #f5f5f5;
      padding: 15px;
      border-radius: 4px;
      font-family: 'Courier New', monospace;
      font-size: 13px;
      white-space: pre-wrap;
    }
    .footer {
      margin-top: 30px;
      padding-top: 20px;
      border-top: 1px solid #ddd;
      font-size: 12px;
      color: #888;
    }
    .timeline {
      background-color: #fff3e0;
      padding: 10px;
      border-radius: 4px;
      margin: 15px 0;
    }
  </style>
</head>
<body>
  <div class="alert-critical">
    <div class="alert-header">
      <span class="alert-icon">🚨</span>
      <span class="alert-title">Critical Alert: {{ .GroupLabels.alertname }}</span>
    </div>
    
    <table style="width: 100%;">
      <tr>
        <td class="label">Severity:</td>
        <td class="value">{{ .CommonLabels.severity }}</td>
      </tr>
      <tr>
        <td class="label">Service:</td>
        <td class="value">{{ .CommonLabels.service }}</td>
      </tr>
      <tr>
        <td class="label">Component:</td>
        <td class="value">{{ .CommonLabels.component }}</td>
      </tr>
      <tr>
        <td class="label">Environment:</td>
        <td class="value">{{ .CommonLabels.environment }}</td>
      </tr>
      <tr>
        <td class="label">Team:</td>
        <td class="value">{{ .CommonLabels.team }}</td>
      </tr>
    </table>
  </div>

  <div class="section">
    <div class="section-title">Description</div>
    <p>{{ .CommonAnnotations.description }}</p>
  </div>

  <div class="section">
    <div class="section-title">Impact</div>
    <p>{{ .CommonAnnotations.impact }}</p>
  </div>

  <div class="section">
    <div class="section-title">Timeline</div>
    <div class="timeline">
      <strong>Started:</strong> {{ .StartsAt.Format "2006-01-02 15:04:05 UTC" }}<br>
      {{ if .EndsAt }}<strong>Ended:</strong> {{ .EndsAt.Format "2006-01-02 15:04:05 UTC" }}{{ else }}<strong>Status:</strong> Still active{{ end }}<br>
      <strong>Duration:</strong> {{ if .EndsAt }}{{ .EndsAt.Sub .StartsAt }}{{ else }}Ongoing{{ end }}
    </div>
  </div>

  <div class="section">
    <div class="section-title">Troubleshooting Steps</div>
    <div class="troubleshooting">{{ .CommonAnnotations.troubleshooting }}</div>
  </div>

  <div class="section">
    <a href="{{ .CommonAnnotations.dashboard_url }}" class="button">📊 View Dashboard</a>
    <a href="{{ .CommonAnnotations.runbook_url }}" class="button">📋 View Runbook</a>
    <a href="https://your-pagerduty.com" class="button">🔗 Acknowledge</a>
  </div>

  <div class="footer">
    <p>
      This is an automated alert from Armored Archer Alertmanager.<br>
      Alert ID: {{ .GroupLabels.alertname }} | Generated: {{ .StartsAt.Format "2006-01-02 15:04:05 UTC" }}
    </p>
    <p>
      To modify alert settings, contact the backend team.<br>
      To unsubscribe from critical alerts, update your on-call preferences.
    </p>
  </div>
</body>
</html>
{{ end }}

