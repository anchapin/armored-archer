# ============================================
# Environment Template (.env.example)
# Copy this file to .env and fill in your values
# ============================================
#
# Issue #1096 — placeholder convention
# ------------------------------------
# This file is the OPERATOR-FACING template. Every credential you see below
# uses the human-readable pattern `your_<name>_here` (or a long-form
# `<change_me_...>` directive) so that:
#
#   1. It is OBVIOUS the value is a placeholder rather than a real secret —
#      no one mistakes "your_postgres_password_here" for a working password.
#   2. `grep -n your_ backend/.env` lists every line that still needs
#      attention, which is exactly the exit 0 / exit 1 contract devs want
#      when reviewing a .env file before a non-local deploy.
#
# Docker Compose also has its own placeholder — `__SET_VIA_DOTENV__` —
# which is what `${POSTGRES_PASSWORD:-__SET_VIA_DOTENV__}` etc. resolve to
# in backend/docker-compose.yml when an operator forgets to set the env
# var in the first place. That sentinel is louder than the older
# "changeme" / "defaultkey" defaults because the nakama container's
# entrypoint fails fast (exit code 78) on the first boot when it sees
# the sentinel, telling the operator to copy this file and fill it in.
#
# Recommended workflow:
#   cp backend/.env.example backend/.env
#   $EDITOR backend/.env           # fill in every "your_*" / "<change_me_*>" line
#   cd backend && docker compose up -d
#
# Generate strong placeholders with:
#   openssl rand -hex 32   # 64-char hex — works for any 'min 32 chars' field
# ============================================

# ============================================
# Nakama Server Configuration
# ============================================
# URL of the Nakama game server
NAKAMA_SERVER_URL=127.0.0.1
# Port for Nakama server (default: 7350)
NAKAMA_SERVER_PORT=7350
# Server key for authentication (change in production!)
NAKAMA_SERVER_KEY=your_nakama_server_key_here
# Port for Nakama admin console (default: 7351)
NAKAMA_CONSOLE_PORT=7351
# Console username for admin access
NAKAMA_CONSOLE_USERNAME=admin
# Console password for admin access (change in production!)
NAKAMA_CONSOLE_PASSWORD=your_console_password_here

# ============================================
# Database Configuration
# ============================================
# PostgreSQL database user
# NOTE: POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB configure BOTH the
# postgres container and the Nakama connection string (docker-compose.yml
# builds the DSN from them). If you change POSTGRES_PASSWORD after the data
# volume already exists, also update it inside postgres:
#   docker exec -it armored_archer_db psql -U postgres \
#     -c "ALTER USER postgres WITH PASSWORD '<new>';"
POSTGRES_USER=postgres
# PostgreSQL database name
POSTGRES_DB=nakama
# PostgreSQL password (change in production!)
POSTGRES_PASSWORD=your_postgres_password_here
# Full database connection string
# Format: postgres://username:password@host:port/database
DATABASE_ADDRESS=postgres://postgres:your_postgres_password_here@postgres:5432/nakama
# Database host address
DB_HOST=postgres
# Database port (default: 5432)
DB_PORT=5432
# Database name
DB_NAME=nakama
# Database user
DB_USER=postgres
# Database password
DB_PASSWORD=your_postgres_password_here

# ============================================
# Session Configuration
# ============================================
# Encryption key for session tokens (min 32 characters, change in production!)
SESSION_ENCRYPTION_KEY=your_session_encryption_key_min_32_chars
# Encryption key for refresh tokens (min 32 characters, change in production!)
REFRESH_ENCRYPTION_KEY=your_refresh_encryption_key_min_32_chars
# Token encryption key (min 32 characters, change in production!)
TOKEN_ENCRYPTION_KEY=your_token_encryption_key_min_32_chars
# Session expiry in seconds (default: 7200 = 2 hours)
SESSION_EXPIRY_SEC=7200

# ============================================
# RevenueCat Configuration
# ============================================
# RevenueCat is used for in-app purchases and subscriptions
# Get your API keys from: https://www.revenuecat.com/
# Public key (used by client SDK and server-side validation)
REVENUECAT_PUBLIC_KEY=your_revenuecat_public_key_here
# Secret key (used for server-side API calls - never expose to client)
REVENUECAT_SECRET_KEY=your_revenuecat_secret_key_here
# Webhook secret (for verifying incoming webhook signatures from RevenueCat)
# REQUIRED for webhook processing: without it the webhook RPC fails closed
# and rejects all events (issue #1067)
REVENUECAT_WEBHOOK_SECRET=your_revenuecat_webhook_secret_here

# Receipt hashing salt (prevents replay attacks on validated receipts)
RECEIPT_HASH_SALT=your_receipt_hash_salt_here_min_32_chars

# ============================================
# Firebase Configuration
# ============================================
# Firebase is used for push notifications and authentication
# Get your config from: https://console.firebase.google.com/
# 1. Create a project at https://console.firebase.google.com/
# 2. Go to Project Settings > General to find your config
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_AUTH_DOMAIN=your_project_id_here.firebaseapp.com
FIREBASE_DATABASE_URL=https://your_project_id_here.firebaseio.com
FIREBASE_STORAGE_BUCKET=your_project_id_here.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here

# ============================================
# Anti-Cheat / HMAC Configuration
# ============================================
# REQUIRED (issue #1076): secret used to verify HMAC-SHA256 request signatures.
# Generate one with: openssl rand -hex 32
# Production refuses to start without it; local dev falls back to an insecure
# secret with a loud warning when it is unset.
HMAC_SECRET=<change_me_generate_with_openssl_rand_hex_32>
# HMAC signature verification is ON by default (issue #1076); set to false only
# for local debugging of unsigned clients.
ENABLE_HMAC_VERIFICATION=true

# ============================================
# Rate Limiting Configuration
# ============================================
# Enable/disable rate limiting
RATE_LIMIT_ENABLED=true
# Default rate limit settings (max requests per window)
RATE_LIMIT_DEFAULT_MAX_REQUESTS=100
RATE_LIMIT_DEFAULT_WINDOW_MS=60000

# Rate Limits per Endpoint (max requests per time window in ms)
RATE_LIMIT_HEALTH_CHECK_MAX=300
RATE_LIMIT_HEALTH_CHECK_WINDOW_MS=60000
RATE_LIMIT_GET_PLAYER_STATS_MAX=60
RATE_LIMIT_GET_PLAYER_STATS_WINDOW_MS=60000
RATE_LIMIT_GAIN_XP_MAX=30
RATE_LIMIT_GAIN_XP_WINDOW_MS=60000
RATE_LIMIT_ALLOCATE_STATS_MAX=30
RATE_LIMIT_ALLOCATE_STATS_WINDOW_MS=60000
RATE_LIMIT_SUBMIT_COMBAT_ACTION_MAX=10
RATE_LIMIT_SUBMIT_COMBAT_ACTION_WINDOW_MS=10000
RATE_LIMIT_GET_MATCH_STATE_MAX=60
RATE_LIMIT_GET_MATCH_STATE_WINDOW_MS=60000
RATE_LIMIT_CREATE_MATCH_MAX=10
RATE_LIMIT_CREATE_MATCH_WINDOW_MS=60000
RATE_LIMIT_ACCEPT_MATCH_MAX=10
RATE_LIMIT_ACCEPT_MATCH_WINDOW_MS=60000
RATE_LIMIT_GET_LEADERBOARD_MAX=30
RATE_LIMIT_GET_LEADERBOARD_WINDOW_MS=60000
RATE_LIMIT_VALIDATE_PURCHASE_MAX=20
RATE_LIMIT_VALIDATE_PURCHASE_WINDOW_MS=60000
RATE_LIMIT_SPEND_GEMS_MAX=20
RATE_LIMIT_SPEND_GEMS_WINDOW_MS=60000
RATE_LIMIT_GENERATE_GEAR_MAX=30
RATE_LIMIT_GENERATE_GEAR_WINDOW_MS=60000
RATE_LIMIT_EQUIP_GEAR_MAX=30
RATE_LIMIT_EQUIP_GEAR_WINDOW_MS=60000

# ============================================
# Logger Configuration
# ============================================
# Log level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=DEBUG
# Log format: json or text
LOG_FORMAT=json
# Log output: stdout or file
LOG_OUTPUT=stdout

# ============================================
# Match Configuration
# ============================================
# Allow localhost connections in matches (development only)
ALLOW_HOST_LOOPBACK=true

# ============================================
# Metrics Configuration
# ============================================
# Prometheus metrics namespace
METRICS_NAMESPACE=nakama
# Prometheus metrics prefix
METRICS_PREFIX=nakama
# Port for Prometheus metrics endpoint
PROMETHEUS_PORT=9100

# ============================================
# Alerting Configuration
# ============================================
# Enable/disable alerting system
ALERTING_ENABLED=false
# Default alert provider (pagerduty, slack, webhook, email, none)
ALERTING_DEFAULT_PROVIDER=none
# Minimum environment level to send alerts (development, staging, production)
ALERTING_MIN_ENV_LEVEL=staging

# Alert Routing - Map severity levels to providers
ALERTING_ROUTING_CRITICAL=pagerduty
ALERTING_ROUTING_ERROR=slack
ALERTING_ROUTING_WARNING=slack
ALERTING_ROUTING_INFO=none

# PagerDuty Configuration (when using pagerduty)
PAGERDUTY_API_KEY=your_pagerduty_api_key_here
PAGERDUTY_SERVICE_ID=your_pagerduty_service_id_here
PAGERDUTY_INTEGRATION_KEY=your_pagerduty_integration_key_here

# ============================================
# Alertmanager Receiver Routing (issue #1094)
# ============================================
# The Alertmanager container in backend/docker-compose.yml wires each
# receiver (backend/alertmanager.yml) to a dedicated env var. The
# container's entrypoint refuses to start while any ALERTMANAGER_*
# var is still the __SET_VIA_DOTENV__ sentinel — matching the #1096
# pattern used for POSTGRES_PASSWORD / NAKAMA_SERVER_KEY /
# GRAFANA_ADMIN_PASSWORD. The full routing diagram (which receiver
# fires for which alerts.yml severity/team label, expected volume,
# escalation policy) lives in backend/docker-compose.yml above the
# `alertmanager:` service entry.
#
# Get the values from:
#   - PagerDuty: https://<subdomain>.pagerduty.com → Services →
#     <service> → Integrations → "Events API v2" (the Integration Key)
#   - Slack:     https://api.slack.com/messaging/webhooks →
#     "Create your Slack apps" → Incoming Webhooks → "Add New Webhook"
#   - SMTP:      your email provider's SMTP credentials
#                 (SendGrid / SES / Postmark / Gmail app passwords)
#
# Generate strong SMTP passwords with:
#   openssl rand -hex 32
# ============================================

# --- Global SMTP (used by every email_configs.*.to address) ---
# Format: host:port (no scheme). Use 587 for STARTTLS, 465 for implicit TLS.
ALERTMANAGER_SMTP_SMARTHOST=your_smtp_host_port_here
# From address on every alert email. Override per environment (dev/staging/prod).
ALERTMANAGER_SMTP_FROM=alerts@armored-archer.example.com
ALERTMANAGER_SMTP_USERNAME=your_smtp_username_here
ALERTMANAGER_SMTP_PASSWORD=your_smtp_password_here

# --- Global PagerDuty endpoint (the events API URL) ---
# Almost always https://events.pagerduty.com/v2/enqueue
ALERTMANAGER_PAGERDUTY_URL=https://events.pagerduty.com/v2/enqueue

# --- Receiver: critical-alerts (severity=critical → email + pager + Slack) ---
# Paged on-call gets paged within ~10s (group_wait) and re-paged hourly.
ALERTMANAGER_CRITICAL_EMAIL=oncall-critical@armored-archer.example.com
ALERTMANAGER_CRITICAL_PAGERDUTY_SERVICE_KEY=your_pagerduty_service_key_here
ALERTMANAGER_CRITICAL_SLACK_API_URL=https://hooks.slack.com/services/your/workspace/and/channel

# --- Receiver: security-alerts (team=security → email + Slack) ---
# Security team gets a page within ~10s, repeats every 2h.
ALERTMANAGER_SECURITY_EMAIL=security-team@armored-archer.example.com
ALERTMANAGER_SECURITY_SLACK_API_URL=https://hooks.slack.com/services/your/workspace/and/channel

# --- Receiver: warning-alerts (severity=warning → email + Slack) ---
# On-call gets a warning within ~30s, repeats every 4h.
ALERTMANAGER_WARNING_EMAIL=oncall@armored-archer.example.com
ALERTMANAGER_WARNING_SLACK_API_URL=https://hooks.slack.com/services/your/workspace/and/channel

# --- Receiver: info-alerts (severity=info → Slack only) ---
# Batched into a 30-minute group window, repeats every 24h.
ALERTMANAGER_INFO_SLACK_API_URL=https://hooks.slack.com/services/your/workspace/and/channel

# --- Receiver: default (catch-all → email only) ---
# Fires for any alert that matches no other route. Use a low-noise mailbox.
ALERTMANAGER_DEFAULT_EMAIL=alerts@armored-archer.example.com

# Slack Configuration (when using slack)
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
SLACK_CHANNEL=#alerts
SLACK_USERNAME=Armored Archer Alert Bot
SLACK_ICON_EMOJI=:warning:

# Webhook Configuration (when using webhook)
ALERT_WEBHOOK_URL=your_webhook_url_here
ALERT_WEBHOOK_METHOD=POST
ALERT_WEBHOOK_AUTH_TYPE=none
ALERT_WEBHOOK_USERNAME=your_webhook_username
ALERT_WEBHOOK_PASSWORD=your_webhook_password
ALERT_WEBHOOK_TOKEN=your_webhook_token

# SMTP/Email Configuration (when using email)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=alerts@armored-archer.com
SMTP_TO=admin@example.com,oncall@example.com

# Health Alert Thresholds
ALERT_CPU_WARNING_PERCENT=70
ALERT_CPU_CRITICAL_PERCENT=90
ALERT_MEMORY_WARNING_PERCENT=75
ALERT_MEMORY_CRITICAL_PERCENT=90
ALERT_DB_CONNECTIONS_WARNING_PERCENT=70
ALERT_DB_CONNECTIONS_CRITICAL_PERCENT=90
ALERT_DISK_WARNING_PERCENT=80
ALERT_DISK_CRITICAL_PERCENT=95
ALERT_RESPONSE_TIME_WARNING_MS=500
ALERT_RESPONSE_TIME_CRITICAL_MS=2000
ALERT_ERROR_RATE_WARNING_PERCENT=5
ALERT_ERROR_RATE_CRITICAL_PERCENT=10

# Metric Alert Thresholds
ALERT_ACTIVE_CONNECTIONS_WARNING=1000
ALERT_ACTIVE_CONNECTIONS_CRITICAL=2000
ALERT_MATCH_QUEUE_WARNING=50
ALERT_MATCH_QUEUE_CRITICAL=100
ALERT_MATCH_WAIT_TIME_WARNING_SEC=60
ALERT_MATCH_WAIT_TIME_CRITICAL_SEC=180
ALERT_DB_QUERY_TIME_WARNING_MS=100
ALERT_DB_QUERY_TIME_CRITICAL_MS=500
ALERT_FAILED_LOGINS_WARNING=10
ALERT_FAILED_LOGINS_CRITICAL=50
ALERT_PURCHASE_FAILURES_WARNING=5
ALERT_PURCHASE_FAILURES_CRITICAL=20

# Alert Cooldowns (in seconds)
ALERT_COOLDOWN_CRITICAL=300
ALERT_COOLDOWN_ERROR=600
ALERT_COOLDOWN_WARNING=900
ALERT_COOLDOWN_INFO=1800

# ============================================
# Environment
# ============================================
# Set to: development, staging, or production
NODE_ENV=development

# ============================================
# Product Analytics Configuration
# ============================================
# Enable/disable analytics tracking
ANALYTICS_ENABLED=false

# Mixpanel Configuration
# Get your API key from: https://mixpanel.com/
MIXPANEL_ENABLED=false
MIXPANEL_API_KEY=your_mixpanel_api_key_here

# Amplitude Configuration
# Get your API key from: https://amplitude.com/
AMPLITUDE_ENABLED=false
AMPLITUDE_API_KEY=your_amplitude_api_key_here

# Segment Configuration
# Get your write key from: https://segment.com/
SEGMENT_ENABLED=false
SEGMENT_WRITE_KEY=your_segment_write_key_here

# Custom Analytics Endpoint (for self-hosted analytics)
ANALYTICS_CUSTOM_ENDPOINT=https://your-analytics-server.com/track
ANALYTICS_CUSTOM_API_KEY=your_custom_api_key_here

# ============================================
# Admin Authorization (issue #1075)
# ============================================
# Comma-separated Nakama user ids allowed to call admin/ops RPCs:
# admin_* season tools, rollout flag management (create/update/list/advance/
# rollback/health/metrics/prometheus), metrics + n_plus_one_report,
# deployment_*, error_insights_*, and the QA replay endpoints.
# Entries must be STRICT UUID v4 (RFC 4122: version nibble 4, variant nibble
# 8/9/a/b; uppercase hex accepted and normalized). Anything else — v1/v5
# UUIDs, dashless hex, truncated ids — crashes the server at startup
# (fail-fast per ADR-0006). Example:
# ADMIN_USER_IDS=00000000-0000-4000-8000-000000000001,00000000-0000-4000-8000-000000000002
# EMPTY BY DEFAULT = every admin RPC rejects every caller (fail-closed).
# Obtain the user id from the Nakama console (Users -> id).
# Validation tip — dry-run your ids before deploy (prints ok or the bad entry):
#   node -e "const ids=(process.argv[1]||'').split(',').map(s=>s.trim()).filter(Boolean);const re=/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;const bad=ids.filter(id=>!re.test(id));console.log(bad.length?('INVALID: '+bad.join(', ')):'ok ('+ids.length+' id(s))')" "PASTE,YOUR,IDS"
# Adding a new admin-guarded RPC? Use scripts/new-admin-rpc.sh (issue #1145)
# and keep it wrapped — enforced by: cd backend && npm run check:admin-coverage
ADMIN_USER_IDS=

# ============================================
# Distributed Tracing (OpenTelemetry, issue #1104)
# ============================================
# Spans are emitted via the NodeSDK OTLPTraceExporter to the
# `otel-collector` service declared in backend/docker-compose.yml, which
# forwards them to Tempo via the `otlphttp/tempo` pipeline. The defaults
# below make tracing ON in development and OFF in production (opt-in there)
# so prod stays fast.
#
# Enable tracing (true|false). Default: true in dev/staging, false in production.
# TRACING_ENABLED=true
# Disable tracing via the OTEL spec variable (overrides TRACING_ENABLED).
# OTEL_SDK_DISABLED=false
# Exporter type (otlp|zipkin|none). Default: otlp.
# TRACING_EXPORTER=otlp
# Disable the exporter at runtime via the OTEL spec variable (overrides
# TRACING_EXPORTER). The SDK still initializes for span context propagation
# but no spans are sent anywhere.
# OTEL_TRACES_EXPORTER=none
# OTLP endpoint — prefers OTEL_EXPORTER_OTLP_ENDPOINT (OTEL spec), then
# OTLP_ENDPOINT, then the docker-compose otel-collector service on :4318
# (HTTP). Use 4317 for the gRPC receiver.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTLP_ENDPOINT=http://otel-collector:4318
# Service identity attached to every span.
# TRACING_SERVICE_NAME=armored-archer-backend
# TRACING_SERVICE_VERSION=0.1.0
# Sampling ratio (0.0-1.0). Default: 1.0 (all spans in dev).
# TRACING_SAMPLE_RATE=1.0
# Auto-instrumentations (default: http,express,pg).
# TRACING_INSTRUMENTATIONS=http,express,pg
# Legacy Zipkin endpoint (only used when TRACING_EXPORTER=zipkin).
# ZIPKIN_ENDPOINT=http://otel-collector:9411
