# ============================================
# Environment Template (.env.example)
# Copy this file to .env and fill in your values
# ============================================

# ============================================
# Nakama Server Configuration
# ============================================
# URL of the Nakama game server
NAKAMA_SERVER_URL=127.0.0.1
# Port for Nakama server (default: 7350)
NAKAMA_SERVER_PORT=7350
# Server key for authentication (change in production!)
NAKAMA_SERVER_KEY=your_nakama_server_key_here
# Port for Nakama admin console (default: 7351)
NAKAMA_CONSOLE_PORT=7351
# Console username for admin access
NAKAMA_CONSOLE_USERNAME=admin
# Console password for admin access (change in production!)
NAKAMA_CONSOLE_PASSWORD=your_console_password_here

# ============================================
# Database Configuration
# ============================================
# PostgreSQL database user
POSTGRES_USER=postgres
# PostgreSQL database name
POSTGRES_DB=nakama
# PostgreSQL password (change in production!)
POSTGRES_PASSWORD=your_postgres_password_here
# Full database connection string
# Format: username:password@host:port/database
DATABASE_ADDRESS=postgres:your_postgres_password_here@postgres:5432/nakama
# Database host address
DB_HOST=postgres
# Database port (default: 5432)
DB_PORT=5432
# Database name
DB_NAME=nakama
# Database user
DB_USER=postgres
# Database password
DB_PASSWORD=your_postgres_password_here

# ============================================
# Session Configuration
# ============================================
# Encryption key for session tokens (min 32 characters, change in production!)
SESSION_ENCRYPTION_KEY=your_session_encryption_key_min_32_chars
# Encryption key for refresh tokens (min 32 characters, change in production!)
REFRESH_ENCRYPTION_KEY=your_refresh_encryption_key_min_32_chars
# Token encryption key (min 32 characters, change in production!)
TOKEN_ENCRYPTION_KEY=your_token_encryption_key_min_32_chars
# Session expiry in seconds (default: 7200 = 2 hours)
SESSION_EXPIRY_SEC=7200

# ============================================
# RevenueCat Configuration
# ============================================
# RevenueCat is used for in-app purchases and subscriptions
# Get your API keys from: https://www.revenuecat.com/
# Production Keys (Replace with actual values when deploying to production)
REVENUECAT_PUBLIC_API_KEY=your_revenuecat_public_key_here
REVENUECAT_SECRET_API_KEY=your_revenuecat_secret_key_here
# Legacy key format (used by some SDK versions)
REVENUECAT_PUBLIC_KEY=your_revenuecat_public_key_here

# Sandbox/Test Keys (Use these during development)
REVENUECAT_SANDBOX_PUBLIC_API_KEY=your_revenuecat_sandbox_public_key_here
REVENUECAT_SANDBOX_SECRET_API_KEY=your_revenuecat_sandbox_secret_key_here

# ============================================
# Firebase Configuration
# ============================================
# Firebase is used for push notifications and authentication
# Get your config from: https://console.firebase.google.com/
# 1. Create a project at https://console.firebase.google.com/
# 2. Go to Project Settings > General to find your config
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_AUTH_DOMAIN=your_project_id_here.firebaseapp.com
FIREBASE_DATABASE_URL=https://your_project_id_here.firebaseio.com
FIREBASE_STORAGE_BUCKET=your_project_id_here.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here

# ============================================
# Rate Limiting Configuration
# ============================================
# Enable/disable rate limiting
RATE_LIMIT_ENABLED=true
# Default rate limit settings (max requests per window)
RATE_LIMIT_DEFAULT_MAX_REQUESTS=100
RATE_LIMIT_DEFAULT_WINDOW_MS=60000

# Rate Limits per Endpoint (max requests per time window in ms)
RATE_LIMIT_HEALTH_CHECK_MAX=300
RATE_LIMIT_HEALTH_CHECK_WINDOW_MS=60000
RATE_LIMIT_GET_PLAYER_STATS_MAX=60
RATE_LIMIT_GET_PLAYER_STATS_WINDOW_MS=60000
RATE_LIMIT_GAIN_XP_MAX=30
RATE_LIMIT_GAIN_XP_WINDOW_MS=60000
RATE_LIMIT_ALLOCATE_STATS_MAX=30
RATE_LIMIT_ALLOCATE_STATS_WINDOW_MS=60000
RATE_LIMIT_SUBMIT_COMBAT_ACTION_MAX=10
RATE_LIMIT_SUBMIT_COMBAT_ACTION_WINDOW_MS=10000
RATE_LIMIT_GET_MATCH_STATE_MAX=60
RATE_LIMIT_GET_MATCH_STATE_WINDOW_MS=60000
RATE_LIMIT_CREATE_MATCH_MAX=10
RATE_LIMIT_CREATE_MATCH_WINDOW_MS=60000
RATE_LIMIT_ACCEPT_MATCH_MAX=10
RATE_LIMIT_ACCEPT_MATCH_WINDOW_MS=60000
RATE_LIMIT_GET_LEADERBOARD_MAX=30
RATE_LIMIT_GET_LEADERBOARD_WINDOW_MS=60000
RATE_LIMIT_VALIDATE_PURCHASE_MAX=20
RATE_LIMIT_VALIDATE_PURCHASE_WINDOW_MS=60000
RATE_LIMIT_SPEND_GEMS_MAX=20
RATE_LIMIT_SPEND_GEMS_WINDOW_MS=60000
RATE_LIMIT_GENERATE_GEAR_MAX=30
RATE_LIMIT_GENERATE_GEAR_WINDOW_MS=60000
RATE_LIMIT_EQUIP_GEAR_MAX=30
RATE_LIMIT_EQUIP_GEAR_WINDOW_MS=60000

# ============================================
# Logger Configuration
# ============================================
# Log level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=DEBUG
# Log format: json or text
LOG_FORMAT=json
# Log output: stdout or file
LOG_OUTPUT=stdout

# ============================================
# Match Configuration
# ============================================
# Allow localhost connections in matches (development only)
ALLOW_HOST_LOOPBACK=true

# ============================================
# Metrics Configuration
# ============================================
# Prometheus metrics namespace
METRICS_NAMESPACE=nakama
# Prometheus metrics prefix
METRICS_PREFIX=nakama
# Port for Prometheus metrics endpoint
PROMETHEUS_PORT=9100

# ============================================
# Environment
# ============================================
# Set to: development, staging, or production
NODE_ENV=development
