# Nakama Configuration
NAKAMA_SERVER_KEY=defaultkey
NAKAMA_PORT=7350
NAKAMA_CONSOLE_PORT=7351

# Database Configuration
DATABASE_ADDRESS=postgres:localdbpassword@postgres:5432/nakama
