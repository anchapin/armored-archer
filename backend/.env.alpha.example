# ============================================
# Alpha Environment Configuration
# Armored Archer - Alpha Deployment
# ============================================
# Copy this file to .env.alpha and update with alpha-specific values
# DO NOT COMMIT THIS FILE TO VERSION CONTROL
# ============================================

# ============================================
# Environment
# ============================================
NODE_ENV=alpha

# ============================================
# Nakama Server Configuration
# ============================================
# Alpha server URL (update with actual alpha server address)
NAKAMA_SERVER_URL=alpha.armored-archer.com
# Port for Nakama server (default: 7350)
NAKAMA_SERVER_PORT=7350
# Server key for authentication - GENERATE UNIQUE KEY FOR ALPHA
NAKAMA_SERVER_KEY=<GENERATE_UNIQUE_ALPHA_KEY_MIN_32_CHARS>
# Port for Nakama admin console (default: 7351)
NAKAMA_CONSOLE_PORT=7351
# Console username for admin access - CHANGE FOR ALPHA
NAKAMA_CONSOLE_USERNAME=admin
# Console password for admin access - CHANGE TO STRONG PASSWORD
NAKAMA_CONSOLE_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# ============================================
# Database Configuration
# ============================================
# PostgreSQL database user
POSTGRES_USER=postgres
# PostgreSQL database name
POSTGRES_DB=nakama
# PostgreSQL password - GENERATE STRONG PASSWORD FOR ALPHA
POSTGRES_PASSWORD=<GENERATE_STRONG_ALPHA_DB_PASSWORD>
# Full database connection string
# Format: postgres://username:password@host:port/database
DATABASE_ADDRESS=postgres://postgres:<DB_PASSWORD>@postgres:5432/nakama
# Database host address
DB_HOST=postgres
# Database port (default: 5432)
DB_PORT=5432
# Database name
DB_NAME=nakama
# Database user
DB_USER=postgres
# Database password
DB_PASSWORD=<GENERATE_STRONG_ALPHA_DB_PASSWORD>

# ============================================
# Session Configuration
# ============================================
# Encryption key for session tokens - GENERATE UNIQUE 32+ CHAR KEY
SESSION_ENCRYPTION_KEY=<GENERATE_UNIQUE_32_CHAR_ALPHA_KEY>
# Encryption key for refresh tokens - GENERATE UNIQUE 32+ CHAR KEY
REFRESH_ENCRYPTION_KEY=<GENERATE_UNIQUE_32_CHAR_ALPHA_KEY>
# Token encryption key - GENERATE UNIQUE 32+ CHAR KEY
TOKEN_ENCRYPTION_KEY=<GENERATE_UNIQUE_32_CHAR_ALPHA_KEY>
# Session expiry in seconds (default: 7200 = 2 hours)
SESSION_EXPIRY_SEC=7200

# ============================================
# RevenueCat Configuration
# ============================================
# Use sandbox keys for alpha testing
REVENUECAT_PUBLIC_API_KEY=<REVENUECAT_SANDBOX_PUBLIC_KEY>
REVENUECAT_SECRET_API_KEY=<REVENUECAT_SANDBOX_SECRET_KEY>
REVENUECAT_PUBLIC_KEY=<REVENUECAT_SANDBOX_PUBLIC_KEY>

# ============================================
# Firebase Configuration
# ============================================
# Firebase is used for push notifications
# Use development/test Firebase project for alpha
FIREBASE_API_KEY=<FIREBASE_ALPHA_API_KEY>
FIREBASE_PROJECT_ID=<FIREBASE_ALPHA_PROJECT_ID>
FIREBASE_AUTH_DOMAIN=<FIREBASE_ALPHA_AUTH_DOMAIN>
FIREBASE_DATABASE_URL=<FIREBASE_ALPHA_DATABASE_URL>
FIREBASE_STORAGE_BUCKET=<FIREBASE_ALPHA_STORAGE_BUCKET>
FIREBASE_MESSAGING_SENDER_ID=<FIREBASE_ALPHA_MESSAGING_SENDER_ID>

# ============================================
# Rate Limiting Configuration
# ============================================
# Enable rate limiting for alpha
RATE_LIMIT_ENABLED=true
# Default rate limit settings (more permissive for alpha testing)
RATE_LIMIT_DEFAULT_MAX_REQUESTS=200
RATE_LIMIT_DEFAULT_WINDOW_MS=60000

# Rate Limits per Endpoint (alpha-specific - more permissive)
RATE_LIMIT_HEALTH_CHECK_MAX=500
RATE_LIMIT_HEALTH_CHECK_WINDOW_MS=60000
RATE_LIMIT_GET_PLAYER_STATS_MAX=100
RATE_LIMIT_GET_PLAYER_STATS_WINDOW_MS=60000
RATE_LIMIT_GAIN_XP_MAX=50
RATE_LIMIT_GAIN_XP_WINDOW_MS=60000
RATE_LIMIT_ALLOCATE_STATS_MAX=50
RATE_LIMIT_ALLOCATE_STATS_WINDOW_MS=60000
RATE_LIMIT_SUBMIT_COMBAT_ACTION_MAX=20
RATE_LIMIT_SUBMIT_COMBAT_ACTION_WINDOW_MS=10000
RATE_LIMIT_GET_MATCH_STATE_MAX=100
RATE_LIMIT_GET_MATCH_STATE_WINDOW_MS=60000
RATE_LIMIT_CREATE_MATCH_MAX=20
RATE_LIMIT_CREATE_MATCH_WINDOW_MS=60000
RATE_LIMIT_ACCEPT_MATCH_MAX=20
RATE_LIMIT_ACCEPT_MATCH_WINDOW_MS=60000
RATE_LIMIT_GET_LEADERBOARD_MAX=50
RATE_LIMIT_GET_LEADERBOARD_WINDOW_MS=60000
RATE_LIMIT_VALIDATE_PURCHASE_MAX=30
RATE_LIMIT_VALIDATE_PURCHASE_WINDOW_MS=60000
RATE_LIMIT_SPEND_GEMS_MAX=30
RATE_LIMIT_SPEND_GEMS_WINDOW_MS=60000
RATE_LIMIT_GENERATE_GEAR_MAX=50
RATE_LIMIT_GENERATE_GEAR_WINDOW_MS=60000
RATE_LIMIT_EQUIP_GEAR_MAX=50
RATE_LIMIT_EQUIP_GEAR_WINDOW_MS=60000

# ============================================
# Logger Configuration
# ============================================
# Log level for alpha (INFO for balanced logging)
LOG_LEVEL=INFO
# Log format: json or text
LOG_FORMAT=json
# Log output: stdout or file
LOG_OUTPUT=stdout

# ============================================
# Match Configuration
# ============================================
# Disable localhost connections in alpha
ALLOW_HOST_LOOPBACK=false

# ============================================
# Metrics Configuration
# ============================================
# Prometheus metrics namespace
METRICS_NAMESPACE=nakama
# Prometheus metrics prefix
METRICS_PREFIX=nakama
# Port for Prometheus metrics endpoint
PROMETHEUS_PORT=9100

# ============================================
# Alerting Configuration
# ============================================
# Enable alerting for alpha (Slack only)
ALERTING_ENABLED=true
# Default alert provider (slack for alpha)
ALERTING_DEFAULT_PROVIDER=slack
# Minimum environment level to send alerts
ALERTING_MIN_ENV_LEVEL=alpha

# Alert Routing - Map severity levels to providers
ALERTING_ROUTING_CRITICAL=slack
ALERTING_ROUTING_ERROR=slack
ALERTING_ROUTING_WARNING=slack
ALERTING_ROUTING_INFO=none

# Slack Configuration (for alpha alerts)
SLACK_WEBHOOK_URL=<SLACK_ALPHA_WEBHOOK_URL>
SLACK_CHANNEL=#alpha-alerts
SLACK_USERNAME=Armored Archer Alpha Bot
SLACK_ICON_EMOJI=:warning:

# Health Alert Thresholds (alpha-specific - more lenient)
ALERT_CPU_WARNING_PERCENT=75
ALERT_CPU_CRITICAL_PERCENT=95
ALERT_MEMORY_WARNING_PERCENT=80
ALERT_MEMORY_CRITICAL_PERCENT=95
ALERT_DB_CONNECTIONS_WARNING_PERCENT=75
ALERT_DB_CONNECTIONS_CRITICAL_PERCENT=95
ALERT_DISK_WARNING_PERCENT=85
ALERT_DISK_CRITICAL_PERCENT=95
ALERT_RESPONSE_TIME_WARNING_MS=750
ALERT_RESPONSE_TIME_CRITICAL_MS=3000
ALERT_ERROR_RATE_WARNING_PERCENT=10
ALERT_ERROR_RATE_CRITICAL_PERCENT=20

# Metric Alert Thresholds (alpha-specific)
ALERT_ACTIVE_CONNECTIONS_WARNING=500
ALERT_ACTIVE_CONNECTIONS_CRITICAL=1000
ALERT_MATCH_QUEUE_WARNING=30
ALERT_MATCH_QUEUE_CRITICAL=60
ALERT_MATCH_WAIT_TIME_WARNING_SEC=90
ALERT_MATCH_WAIT_TIME_CRITICAL_SEC=300
ALERT_DB_QUERY_TIME_WARNING_MS=150
ALERT_DB_QUERY_TIME_CRITICAL_MS=750
ALERT_FAILED_LOGINS_WARNING=20
ALERT_FAILED_LOGINS_CRITICAL=100
ALERT_PURCHASE_FAILURES_WARNING=10
ALERT_PURCHASE_FAILURES_CRITICAL=30

# Alert Cooldowns (in seconds)
ALERT_COOLDOWN_CRITICAL=300
ALERT_COOLDOWN_ERROR=600
ALERT_COOLDOWN_WARNING=900
ALERT_COOLDOWN_INFO=1800

# ============================================
# Product Analytics Configuration
# ============================================
# Enable analytics for alpha testing
ANALYTICS_ENABLED=true

# Mixpanel Configuration (optional)
MIXPANEL_ENABLED=false
MIXPANEL_API_KEY=<MIXPANEL_ALPHA_API_KEY>

# Amplitude Configuration (optional)
AMPLITUDE_ENABLED=false
AMPLITUDE_API_KEY=<AMPLITUDE_ALPHA_API_KEY>

# ============================================
# Alpha-Specific Configuration
# ============================================
# Alpha build identifier
ALPHA_BUILD_ID=alpha-001
# Alpha version tag
ALPHA_VERSION=v2.1.0-alpha.1
# Enable debug endpoints for alpha testing
ALPHA_DEBUG_ENABLED=true
# Enable test users for alpha
ALPHA_TEST_USERS_ENABLED=true
# Max concurrent test users
ALPHA_MAX_TEST_USERS=100

# ============================================
# Security Configuration
# ============================================
# Enable CORS for alpha domain
CORS_ALLOWED_ORIGINS=https://alpha.armored-archer.com,https://staging.armored-archer.com
# Enable HTTPS redirect
HTTPS_REDIRECT=true
# Enable security headers
SECURITY_HEADERS_ENABLED=true

# ============================================
# Docker Configuration
# ============================================
# Docker image tag for alpha
DOCKER_IMAGE_TAG=alpha-latest
# Docker registry
DOCKER_REGISTRY=ghcr.io/armored-archer
