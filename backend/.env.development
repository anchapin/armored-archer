REFRESH_ENCRYPTION_KEY=default-refresh-key
TOKEN_ENCRYPTION_KEY=default-token-key
<<<<<<< HEAD
SESSION_ENCRYPTION_KEY=default-token-key

# Logger Configuration
LOG_LEVEL=DEBUG
LOG_FORMAT=json
LOG_OUTPUT=stdout

# Match Configuration
ALLOW_HOST_LOOPBACK=true

# Metrics Configuration
METRICS_NAMESPACE=nakama
METRICS_PREFIX=nakama
PROMETHEUS_PORT=9100

# Alerting Configuration
ALERTING_ENABLED=false
ALERTING_DEFAULT_PROVIDER=none
ALERTING_MIN_ENV_LEVEL=development
