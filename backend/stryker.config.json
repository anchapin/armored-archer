{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker/master/packages/core/schema/stryker-core.schema.json",
  "mutate": [
    "src/modules/combat_system.ts",
    "src/modules/matchmaker.ts",
    "src/modules/rpg_system.ts",
    "src/modules/gear_system.ts",
    "src/modules/store.ts",
    "src/modules/season_system.ts",
    "src/modules/analytics.ts",
    "src/modules/notifications.ts"
  ],
  "testRunner": "jest",
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "reporters": ["html", "json", "clear-text"],
  "jest": {
    "projectType": "custom",
    "configFile": "jest.config.js"
  },
  "htmlReporter": {
    "fileName": "reports/mutation/mutation-report.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation-report.json"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },
  "concurrency": 2,
  "timeoutMS": 30000,
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "inPlace": false
}
