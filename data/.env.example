# RevenueCat Configuration (DO NOT COMMIT TO VERSION CONTROL)

# Production Keys (Replace with actual values when deploying to production)
REVENUECAT_PUBLIC_API_KEY=""
REVENUECAT_SECRET_API_KEY=""

# Sandbox/Test Keys (Use these during development)
REVENUECAT_SANDBOX_PUBLIC_API_KEY=""
REVENUECAT_SANDBOX_SECRET_API_KEY=""

# Platform-specific configurations
[ios]
app_store_connect_team_id=""
app_bundle_id="com.armoredarcher.game"

[android]
google_play_console_package_name="com.armoredarcher.game"
amazon_appstore_package_name="com.armoredarcher.game"

# Testing
SANDBOX_MODE=true
ENABLE_LOGGING=true
