# Network Configuration
NAKAMA_SERVER_URL=127.0.0.1
NAKAMA_SERVER_PORT=7350
NAKAMA_SERVER_KEY=defaultkey
NAKAMA_CONSOLE_PORT=7351

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=nakama
DATABASE_ADDRESS=postgres://changeme@postgres:5432/nakama

# Session Configuration
SESSION_ENCRYPTION_KEY=default-token-key
REFRESH_ENCRYPTION_KEY=default-refresh-key

# RevenueCat Configuration
# Production Keys (Replace with actual values when deploying to production)
REVENUECAT_PUBLIC_API_KEY=
REVENUECAT_SECRET_API_KEY=

# Sandbox/Test Keys (Use these during development)
REVENUECAT_SANDBOX_PUBLIC_API_KEY=
REVENUECAT_SANDBOX_SECRET_API_KEY=

# Firebase Configuration
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=

# Environment
NODE_ENV=development

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_MATCHMAKING=true
ENABLE_LEADERBOARDS=true
