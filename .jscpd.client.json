{
  "threshold": 12,
  "min-lines": 5,
  "min-tokens": 30,
  "reporters": ["console", "json"],
  "output": "./.jscpd-report",
  "ignore": [
    "**/node_modules/**",
    "**/build/**",
    "**/dist/**",
    "**/.git/**",
    "**/coverage/**",
    "**/__mocks__/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/test/**",
    "**/tests/**",
    "**/*.test.js",
    "**/*.test.gd",
    "**/__pycache__/**",
    "**/*.pyc",
    "**/backend/node_modules/**",
    "**/backend/dist/**",
    "**/backend/build/**",
    "**/.planning/**",
    "**/.claude/**"
  ],
  "format": ["typescript", "tsx", "javascript", "jsx", "gdscript", "python"],
  "mode": "weak"
}
