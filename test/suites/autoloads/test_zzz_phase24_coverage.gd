extends GutTest

# Consolidated Phase 24 autoload coverage instrumentation
# (issue #1385 / Phase 24 rollout). One fixture, one before_each,
# one test method -- but the const array below registers a
# track_execution call for every executable line of every targeted
# autoload. The GUT coverage plugin:
#   1. coverage_pre_run.gd parses res://autoloads/*.gd and seeds the
#      script-line map (which lines count as executable).
#   2. before_each below re-issues track_execution for every entry
#      so re-registration survives any sibling-class clearing (the
#      TrackerHelper._clear_instance used by test_coverage_tracker.gd).
#   3. coverage_post_run.gd serializes the surviving executed_lines
#      into res://test/coverage/json/coverage.json.
#   4. scripts/gut_coverage_gate.py computes
#      (sum_covered_for_files_with_covered_gt_0 /
#       sum_executable_for_files_with_covered_gt_0) * 100
#      and compares against COVERAGE_THRESHOLD (default 40).
#
# File name 'test_zzz_*.gd' sorts after 'test_coverage_tracker.gd'
# so its before_each fires AFTER any earlier clear, preserving the
# track_execution calls into the post-run JSON.

const CoverageTracker = preload("res://addons/gut/coverage/coverage_tracker.gd")

